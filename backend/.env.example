# 是否启用 AI 对话能力。
AI_CHAT_ENABLED=true
# 大模型服务提供商标识。
LLM_PROVIDER=openai-compatible
# 大模型 API Key。
LLM_API_KEY=
# 大模型接口基础地址。
LLM_BASE_URL=https://api.openai.com/v1
# 默认使用的模型名称。
LLM_MODEL=gpt-4.1-mini
# 单次 AI 响应允许生成的最大 token 数。
LLM_MAX_TOKENS=1200
# AI 输出温度，越低越稳定。
LLM_TEMPERATURE=0.2
# 单个会话保留的最近消息轮数。
AI_SESSION_LIMIT=10
# 单次 AI 请求超时时间，单位毫秒。
AI_REQUEST_TIMEOUT_MS=30000
# AI 接口限流窗口，单位毫秒。
AI_RATE_LIMIT_WINDOW_MS=60000
# AI 接口窗口内最大请求数。
AI_RATE_LIMIT_MAX=10
# HTTP detail 快速路径开关，默认关闭。
HTTP_DETAIL_ENABLED=false
# HTTP detail 快速路径超时，单位毫秒。
HTTP_DETAIL_TIMEOUT_MS=800
# DOM 加载完成后继续等待视频详情接口的最长时间，默认 8000 毫秒（8 秒）。
# 有效响应到达后立即返回，不会固定等待 8 秒。
POST_LOAD_DETAIL_WAIT_MS=8000
# 可选的手动 Cookie，默认留空；已使用会话目录时通常无需填写。
# 格式示例：cookie_name=cookie_value; another_name=another_value。不要提交真实 Cookie。
DOUYIN_COOKIE=
# 抖音浏览器会话目录，用于保存并复用登录和验证状态；代码默认留空，示例启用专用目录。
# 相对路径基于命令启动目录；在 backend/ 下运行时，browserData 指向 backend/browserData。
# 不要使用日常 Chrome 的 User Data 目录，也不要提交会话目录。
# Linux 示例：/home/用户名/.douyin-parser/browser-session
# Windows 示例：C:/Users/用户名/.douyin-parser/browser-session
# 首次使用先运行 pnpm douyin:session，完成验证或登录后关闭整个浏览器，再运行 pnpm start。
DOUYIN_BROWSER_USER_DATA_DIR=browserData
# 可选的 Chrome/Chromium 可执行文件路径，默认留空，使用 Puppeteer 自带浏览器。
# Linux 示例：/usr/bin/google-chrome
# Windows 示例：C:/Program Files/Google/Chrome/Application/chrome.exe
DOUYIN_BROWSER_EXECUTABLE_PATH=
# 后端浏览器是否无界面运行，默认 true；桌面环境遇到验证问题时可设为 false。
# pnpm douyin:session 始终打开可视浏览器，不受此参数影响。
DOUYIN_BROWSER_HEADLESS=true
# 短链跳转缓存有效期，单位毫秒。
SHORT_URL_CACHE_TTL_MS=600000
# Bilibili DASH 单个临时媒体流最大下载字节数，默认 500 MiB。
BILIBILI_MAX_MEDIA_BYTES=524288000
# Bilibili FFmpeg 合并并发数，默认 1。
BILIBILI_MAX_MUX_CONCURRENCY=1
