# 是否启用 AI 对话能力。
AI_CHAT_ENABLED=true
# 大模型服务提供商标识。
LLM_PROVIDER=openai-compatible
# 大模型 API Key。
LLM_API_KEY=
# 大模型接口基础地址。
LLM_BASE_URL=https://api.openai.com/v1
# 默认使用的模型名称。
LLM_MODEL=gpt-4.1-mini
# 单次 AI 响应允许生成的最大 token 数。
LLM_MAX_TOKENS=1200
# AI 输出温度，越低越稳定。
LLM_TEMPERATURE=0.2
# 单个会话保留的最近消息轮数。
AI_SESSION_LIMIT=10
# 单次 AI 请求超时时间，单位毫秒。
AI_REQUEST_TIMEOUT_MS=30000
# AI 接口限流窗口，单位毫秒。
AI_RATE_LIMIT_WINDOW_MS=60000
# AI 接口窗口内最大请求数。
AI_RATE_LIMIT_MAX=10
# HTTP detail 快速路径开关，默认关闭。
HTTP_DETAIL_ENABLED=false
# HTTP detail 快速路径超时，单位毫秒。
HTTP_DETAIL_TIMEOUT_MS=800
# 短链跳转缓存有效期，单位毫秒。
SHORT_URL_CACHE_TTL_MS=600000
